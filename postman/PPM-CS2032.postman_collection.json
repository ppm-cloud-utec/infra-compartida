    {
      "name": "4. EL EDA (lo mas importante)",
      "item": [
        {
          "name": "a) Avance ANTES",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{portafolios}}/proyectos/1",
              "host": [
                "{{portafolios}}/proyectos/1"
              ]
            },
            "description": "Anota el campo avance_pct."
          }
        },
        {
          "name": "b) Tareas pendientes del proyecto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{tareas}}/proyectos/1/tareas?estado=pendiente&limite=3",
              "host": [
                "{{tareas}}/proyectos/1/tareas?estado=pendiente&limite=3"
              ]
            },
            "description": "Copia un tarea_id para el siguiente paso."
          }
        },
        {
          "name": "c) COMPLETAR una tarea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{tareas}}/proyectos/1/tareas/PEGA_AQUI_EL_TAREA_ID/completar",
              "host": [
                "{{tareas}}/proyectos/1/tareas/PEGA_AQUI_EL_TAREA_ID/completar"
              ]
            },
            "description": "Esto llama SOLO a ms-tareas. Publica tarea.completada en SNS."
          }
        },
        {
          "name": "d) Avance DESPUES (espera ~3s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{portafolios}}/proyectos/1",
              "host": [
                "{{portafolios}}/proyectos/1"
              ]
            },
            "description": "El avance_pct CAMBIO. Nadie llamo a ms-portafolios: lo recalculo\nsu worker al recibir el evento por SQS. Eso es el EDA."
          }
        }
      ]
    },
