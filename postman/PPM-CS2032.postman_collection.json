  "item": [
    {
      "name": "0. Demostrar que estan PROTEGIDOS",
      "item": [
        {
          "name": "GET /health SIN token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identidad}}/health",
              "host": [
                "{{identidad}}/health"
              ]
            },
            "description": "La palabra 'protegidos' del enunciado. Sin token, API Gateway\nresponde 401 ANTES de llegar a la Lambda."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /proyectos SIN token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{portafolios}}/proyectos",
              "host": [
                "{{portafolios}}/proyectos"
              ]
            },
            "description": "Lo mismo en otro microservicio: el authorizer es compartido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Login",
      "item": [
        {
          "name": "1. Login Acme",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identidad}}/login",
              "host": [
                "{{identidad}}/login"
              ]
            },
            "description": "Devuelve el JWT con el tenant_id adentro. El script guarda el token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"t-acme\",\n  \"email\": \"admin@acme.com.pe\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(r.datos.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', r.datos.token);",
                  "console.log('Tenant activo:', r.datos.usuario.tenant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Login Globex",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identidad}}/login",
              "host": [
                "{{identidad}}/login"
              ]
            },
            "description": "Cambia de organizacion. Las mismas peticiones devolveran otros datos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"t-globex\",\n  \"email\": \"admin@globex.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.datos.token);",
                  "console.log('Tenant activo:', r.datos.usuario.tenant_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /tenants (publico)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identidad}}/tenants",
              "host": [
                "{{identidad}}/tenants"
              ]
            },
            "description": "Las 3 organizaciones. Alimenta el selector del login."
          }
        },
        {
          "name": "GET /perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{identidad}}/perfil",
              "host": [
                "{{identidad}}/perfil"
              ]
            },
            "description": "Quien soy, segun el token."
          }
        },
        {
          "name": "GET /usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{identidad}}/usuarios?limite=5",
              "host": [
                "{{identidad}}/usuarios?limite=5"
              ]
            },
            "description": "Usuarios del tenant del token. Hay 10,001 por tenant."
          }
        }
      ]
    },
    {
      "name": "2. AISLAMIENTO entre tenants",
      "item": [
        {
          "name": "Con token de Globex: usuario de Acme -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{identidad}}/usuarios/admin@acme.com.pe",
              "host": [
                "{{identidad}}/usuarios/admin@acme.com.pe"
              ]
            },
            "description": "ESTE ES EL QUE IMPORTA. El usuario existe, pero no en la\nparticion de Globex. Corre antes '1. Login Globex'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No ve datos del otro tenant', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Con token de Acme: su propio usuario -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{identidad}}/usuarios/admin@acme.com.pe",
              "host": [
                "{{identidad}}/usuarios/admin@acme.com.pe"
              ]
            },
            "description": "El mismo endpoint, con el token correcto. Corre antes '1. Login Acme'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Si ve lo suyo', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
